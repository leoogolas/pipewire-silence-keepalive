[Unit]
Description=PipeWire Silent Audio Keepalive
Documentation=https://github.com/leoogolas/pipewire-silence-keepalive
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=@PW_CAT_PATH@ --playback --raw --rate 48000 --channels 2 --format s16 /dev/zero
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
